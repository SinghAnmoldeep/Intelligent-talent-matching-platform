<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Intelligent Talent Matching Platform</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/style.css">
</head>
<body>

  <div class="page-wrapper">
    <div class="card">

      <!-- Logo Icon -->
      <div class="logo-circle">
        <img src="/frontend/assets/Logo.png" alt="Talent Match Logo" class="logo-img">
      </div>

      <!-- Title -->
      <h1 class="title">Intelligent Talent Matching Platform</h1>
      <p class="subtitle">Connect the right talent with the right opportunities</p>

      <!-- Role Selection -->
      <p class="role-label">Select your role to continue</p>

      <div class="role-cards">

        <!-- Candidate Card -->
        <div class="role-card" id="card-candidate" onclick="selectRole('candidate')">
          <div class="role-icon">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="12" cy="8" r="4" stroke="#6b7280" stroke-width="1.8" fill="none"/>
              <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke="#6b7280" stroke-width="1.8" stroke-linecap="round" fill="none"/>
              <circle cx="12" cy="12" r="11" stroke="#6b7280" stroke-width="1.5" fill="none"/>
            </svg>
          </div>
          <h2 class="role-title">I'm a Candidate</h2>
          <p class="role-desc">Find your dream job and get personalized recommendations</p>
          <div class="check-indicator">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <circle cx="8" cy="8" r="8" fill="#5046e5"/>
              <path d="M4.5 8l2.5 2.5 4.5-4.5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>

        <!-- Employer Card -->
        <div class="role-card" id="card-employer" onclick="selectRole('employer')">
          <div class="role-icon">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="2" y="7" width="20" height="14" rx="2" stroke="#6b7280" stroke-width="1.8" fill="none"/>
              <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" stroke="#6b7280" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </div>
          <h2 class="role-title">I'm an Employer</h2>
          <p class="role-desc">Post jobs and discover the best talent for your team</p>
          <div class="check-indicator">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <circle cx="8" cy="8" r="8" fill="#5046e5"/>
              <path d="M4.5 8l2.5 2.5 4.5-4.5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>

      </div>

      <!-- Continue Button -->
      <button class="btn-continue" id="btn-continue" onclick="handleContinue()" disabled>
        Continue as ...
      </button>

    </div>
  </div>

<script src="js/landing.js"></script>

</body>
</html>
